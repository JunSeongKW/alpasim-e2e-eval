FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python-is-python3 \
        git \
        libglib2.0-0 \
        libgl1 \
    && python -m pip install --upgrade pip \
    && rm -rf /var/lib/apt/lists/*

# Keep the CUDA/PyTorch/MMCV stack identical to the working CNX stage3 image.
RUN python -m pip install \
    torch==2.0.1 \
    torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

ENV XDG_CACHE_HOME=/tmp/.cache
ENV TORCH_HOME=/tmp/torch
ENV MPLCONFIGDIR=/tmp/matplotlib
ENV CUDA_CACHE_PATH=/tmp/nv
ENV NUMBA_CACHE_DIR=/tmp/numba

ENV ALPASIM_DRIVER_LOG_DIR=/run/alpasim-driver

ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
ENV TORCH_NUM_THREADS=1
ENV TORCH_NUM_INTEROP_THREADS=1

WORKDIR /app

# AlpaSim gRPC package. The build script stages these files in its temporary
# context so this image no longer depends on a prebuilt CNX stage3 image.
COPY alpasim_grpc /tmp/alpasim_grpc
COPY patch_grpc_py310.py /tmp/patch_grpc_py310.py

RUN python /tmp/patch_grpc_py310.py \
    && pip install /tmp/alpasim_grpc \
    && rm -rf /tmp/alpasim_grpc /tmp/patch_grpc_py310.py

# DriveSuprim runtime dependencies.
COPY requirements.txt /tmp/requirements.txt

RUN pip install -r /tmp/requirements.txt \
    && pip install "mmcv-full==1.7.2" \
         -f https://download.openmmlab.com/mmcv/dist/cu118/torch2.0/index.html \
         --only-binary mmcv-full \
    && pip install "mmdet==2.28.2" mmengine \
    && pip uninstall -y opencv-python opencv-python-headless \
    && pip install --force-reinstall \
         "numpy==1.23.4" \
         "opencv-python-headless==4.9.0.80" \
    && rm -f /tmp/requirements.txt

# Exact AXE NuRec ViT-S source and model package.
COPY navsim /app/navsim
COPY model.ckpt /app/assets/drivesuprim/axe_nurec_vits.ckpt
COPY nurec_train_kmeans_4096x40x3.npy \
    /app/assets/drivesuprim/nurec_train_kmeans_4096x40x3.npy
COPY axe_nurec_vits_config.json \
    /app/assets/drivesuprim/axe_nurec_vits_config.json
COPY PACKAGE_README.md /app/assets/drivesuprim/AXE_NUREC_VITS_README.md

# AlpaSim driver plumbing.
COPY vavam_challenge /app/vavam_challenge
COPY drivesuprim_challenge /app/drivesuprim_challenge

ENV ALPASIM_DRIVER_HOST=0.0.0.0
ENV ALPASIM_DRIVER_PORT=6789
ENV ALPASIM_DRIVER_GRPC_WORKERS=8

ENV DRIVESUPRIM_REQUIRE_POLICY_FOR_VERSION=0
ENV DRIVESUPRIM_SESSION_STARTUP_TIMEOUT_S=600
ENV DRIVESUPRIM_MAX_BATCH_SIZE=1
ENV DRIVESUPRIM_BATCH_WAIT_MS=5
ENV DRIVESUPRIM_INFERENCE_INTERVAL_US=100000

ENV DRIVESUPRIM_ASSET_DIR=/app/assets/drivesuprim
ENV DRIVESUPRIM_BACKBONE_TYPE=bevformer_m
ENV DRIVESUPRIM_CONFIG_PATH=/app/assets/drivesuprim/axe_nurec_vits_config.json
ENV DRIVESUPRIM_CHECKPOINT_PATH=/app/assets/drivesuprim/axe_nurec_vits.ckpt
ENV DRIVESUPRIM_VOCAB_PATH=/app/assets/drivesuprim/nurec_train_kmeans_4096x40x3.npy
ENV DRIVESUPRIM_BACKBONE_PATH=

ENV DRIVESUPRIM_PINHOLE_PROFILE=K377_512X256
ENV DRIVESUPRIM_NAVSIM_2HZ_HISTORY=1
ENV DRIVESUPRIM_REQUIRE_EXACT_CHECKPOINT=1

ENV DRIVESUPRIM_USE_FP16=0
ENV DRIVESUPRIM_NATIVE_FP16=0
ENV DRIVESUPRIM_CHANNELS_LAST=0
ENV DRIVESUPRIM_DISABLE_INFERENCE=0

# The published mmcv-full 1.7.2 cu118 wheel does not contain an H100-compatible
# ms_deformable_im2col CUDA kernel. Use MMCV's numerically equivalent PyTorch
# implementation instead of launching an unsupported binary kernel.
ENV DRIVESUPRIM_FORCE_PYTORCH_MSDA=1

ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

EXPOSE 6789

CMD ["python", "-m", "drivesuprim_challenge.driver"]
